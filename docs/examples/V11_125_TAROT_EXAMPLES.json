          "id": "celtic-waite-reflective-v1",
          "version": 1,
          "name": "Celtic Cross · Waite / phản tư",
          "positions": [
            {
              "id": "p1",
              "label": "Điều đang xét",
              "role": "focus",
              "prompt": "Mô tả trọng tâm hiện tại qua biểu tượng; đối chiếu điều đang xảy ra, không gán đặc điểm cố định.",
              "x": 1,
              "y": 2,
              "rotation": 0
            },
            {
              "id": "p2",
              "label": "Điểm cần đối chiếu",
              "role": "challenge",
              "prompt": "Xét điều cản trở hoặc đặt vấn đề cho trọng tâm. Một lá xuôi vẫn có thể nói về thử thách ở vị trí này.",
              "x": 1,
              "y": 2,
              "rotation": 90
            },
            {
              "id": "p3",
              "label": "Mục tiêu / lý tưởng",
              "role": "aim",
              "prompt": "Phân biệt điều mong đạt với điều đã đạt. Kiểm tra mục tiêu có phù hợp nguồn lực và giá trị hiện tại.",
              "x": 1,
              "y": 0,
              "rotation": 0
            },
            {
              "id": "p4",
              "label": "Nền tảng",
              "role": "basis",
              "prompt": "Xem điều kiện và thói quen đang làm nền. Không biến lá bài thành bằng chứng về quá khứ.",
              "x": 1,
              "y": 4,
              "rotation": 0
            },
            {
              "id": "p5",
              "label": "Ảnh hưởng cũ",
              "role": "past",
              "prompt": "Đối chiếu trải nghiệm đã biết và ảnh hưởng đang qua; không suy một sự kiện quá khứ chỉ từ lá.",
              "x": 0,
              "y": 2,
              "rotation": 0
            },
            {
              "id": "p6",
              "label": "Hướng diễn tiến",
              "role": "next",
              "prompt": "Khảo sát một khả năng nếu các điều kiện tiếp tục; nêu lựa chọn có thể thay đổi hướng ấy, không ấn định tương lai.",
              "x": 2,
              "y": 2,
              "rotation": 0
            },
            {
              "id": "p7",
              "label": "Cách tiếp cận của bạn",
              "role": "self",
              "prompt": "Xem thái độ và phần có thể chủ động trong việc đang hỏi, không gán nhân cách cố định.",
              "x": 4,
              "y": 6,
              "rotation": 0
            },
            {
              "id": "p8",
              "label": "Môi trường",
              "role": "environment",
              "prompt": "Đọc bối cảnh, thông tin và quan hệ bên ngoài. Không suy người khác nghĩ gì khi chưa có lời xác nhận.",
              "x": 4,
              "y": 4,
              "rotation": 0
            },
            {
              "id": "p9",
              "label": "Hy vọng / lo ngại",
              "role": "hopes",
              "prompt": "Tách điều mong muốn, điều sợ và điều có bằng chứng. Hai mặt có thể cùng tồn tại.",
              "x": 4,
              "y": 2,
              "rotation": 0
            },
            {
              "id": "p10",
              "label": "Tổng hợp có điều kiện",
              "role": "synthesis",
              "prompt": "Nối các vị trí trước thành giả thuyết có điều kiện và câu hỏi kiểm tra; đây không phải lời tiên đoán kết quả.",
              "x": 4,
              "y": 0,
              "rotation": 0
            }
          ]
        }
      }
