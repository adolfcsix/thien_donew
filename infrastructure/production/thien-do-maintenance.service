[Unit]
Description=Thien Do expired authentication record maintenance
OnFailure=thien-do-alert@%n.service
After=docker.service
Requires=docker.service
[Service]
Type=oneshot
User=root
UMask=0077
Environment=THIENDO_CONFIG_DIR=/opt/thien-do/production
ExecStart=/opt/thien-do/production/maintenance.sh --apply
TimeoutStartSec=300
