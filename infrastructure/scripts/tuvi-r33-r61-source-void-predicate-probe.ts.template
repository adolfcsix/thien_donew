/**
 * R61 genuine source detector oracle — operate ONLY in immutable, pinned
 * Renhuai123/ziwei-doushu checkout. No copy of source algorithm, no chart edits.
 * 10 year stems × 4 dates × 12 hour branches × 2 genders = 960 charts.
 * For three unresolved patterns, observe six DISTINCT void labels by branch
 * and independently reconstruct the Boolean predicates.
 * A source match is never a Thiên Đồ formation verdict.
 */
import {readFileSync,writeFileSync} from 'node:fs';
import {astro} from 'iztro';
import {Lunar,LunarMonth} from 'lunar-typescript';
import {execFileSync} from 'node:child_process';
import {generateChart} from './lib/ziwei/algorithm';
import {DING_PIN_GE,detectDingPin} from './lib/ziwei/patterns-dingpin';
import {DING_ZA_GE,detectDingZa} from './lib/ziwei/patterns-dingza';
const source='7922285d947b36610e7e31c232d8f1e2a0d0871d';
const lock=JSON.parse(readFileSync('package-lock.json','utf8'));
const installed=JSON.parse(readFileSync('node_modules/iztro/package.json','utf8'));
if(execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim()!==source || installed.version!=='2.6.1'||lock.packages?.['node_modules/iztro']?.version!=='2.6.1')
 throw Error('R61 iztro dependency is not pinned');
const names=['旬空','副旬','截路','截空','空亡','副截'] as const;
const byNo=<T extends {no:number;name:string}>(list:readonly T[],number:number,name:string):T=>{
 const hits=list.filter(x=>x.no===number&&x.name===name);
 if(hits.length!==1)throw Error('R61 source detector entry missing/duplicated: '+name);
 return hits[0];
};
const ban1=byNo(DING_PIN_GE,1,'生不逢时');
const ban2=byNo(DING_PIN_GE,2,'禄逢两杀');
const tap3=byNo(DING_ZA_GE,3,'禄衰马困');
if(!ban1.fn||!ban2.fn||!tap3.judge)throw Error('R61 source detector disabled');
const years=Array.from({length:10},(_,i)=>1984+i);
const months=[2,5,8,11];
const sorted=(values:number[])=>values.sort((a,b)=>a-b);
const records=[];
for(const year of years)for(const month of months)
 for(const gender of ['male','female'] as const)
  for(let hour=0;hour<12;hour++){
   const chart=generateChart({year,month,day:15,hour,gender});
   if(chart.palaces.length!==12||chart.daXians.length!==12)
    throw Error('R61 incomplete genuine source chart');
   const byBranch=new Map(chart.palaces.map(p=>[p.branch,p]));
   if(byBranch.size!==12||[...byBranch.keys()].some(x=>!Number.isInteger(x)||x<0||x>11))
    throw Error('R61 source duplicate branch (palace indexes are NOT branch indices)');
   const at=(branch:number)=>byBranch.get(branch)!;
   const has=(branch:number,name:string)=>at(branch).stars.some(s=>s.name===name);
   const isVoid=(branch:number)=>names.some(name=>has(branch,name));
   const namedVoid=Object.fromEntries(names.map(name=>[
    name,sorted(chart.palaces.filter(p=>p.stars.some(s=>s.name===name)).map(p=>p.branch))
   ]));
   const ming=chart.mingGongBranch;
   const seven=chart.palaces.find(p=>has(p.branch,'七杀'))?.branch;
   const luBranch=chart.palaces.find(p=>has(p.branch,'禄存'))?.branch;
   const horseBranch=chart.palaces.find(p=>has(p.branch,'天马'))?.branch;
   if(!Number.isInteger(ming)||ming<0||ming>11||
      !Number.isInteger(seven)||!Number.isInteger(luBranch)||
      !Number.isInteger(horseBranch))
    throw Error('R61 source mandatory star placement missing');
   const sourceMingVoid=names.filter(name=>has(ming,name));
   const liem=has(ming,'廉贞');
   const luMing=has(ming,'禄存')||at(ming).stars.some(s=>s.siHua==='禄');
   const kongJieBoth=has(ming,'地空')&&has(ming,'地劫');
   const independentBan1=sourceMingVoid.length>0&&liem;
   const independentBan2=sourceMingVoid.length>0&&luMing&&kongJieBoth;
   const sourceBan1=Boolean(ban1.fn(chart));
   const sourceBan2=Boolean(ban2.fn(chart));
   const detected=detectDingPin(chart);
   if(sourceBan1!==independentBan1||sourceBan2!==independentBan2||
      detected.some(x=>x.no===1)!==sourceBan1||
      detected.some(x=>x.no===2)!==sourceBan2)
    throw Error('R61 source Ding Pin predicate mismatch');
   const sortedPeriods=[...chart.daXians].sort((a,b)=>a.startAge-b.startAge);
   const independentTap3=sortedPeriods.filter(dx=>{
    const b=dx.palaceBranch;
    const four=[b,(b+4)%12,(b+8)%12,(b+6)%12];
    return four.includes(seven!)&&isVoid(luBranch!)&&isVoid(horseBranch!);
   }).map(dx=>dx.startAge);
   const actualTap3=tap3.judge(chart,sortedPeriods).map(x=>x.dx?.startAge);
   const observedTap3=detectDingZa(chart).filter(x=>x.no===3).map(x=>x.startAge);
   if(JSON.stringify(independentTap3)!==JSON.stringify(actualTap3)||
      JSON.stringify(actualTap3)!==JSON.stringify(observedTap3))
    throw Error('R61 source Ding Za period predicate mismatch');
   // R76: record raw library date separately from generateChart's reported date.
   // R69 demonstrated these can differ on leap-month boundaries.
   const raw=astro.bySolar([year,month,15].join('-'),hour,gender==='male'?'男':'女',true,'zh-CN').rawDates.lunarDate;
   const point=(lunarYear:number,lunarMonth:number,lunarDay:number,leap:boolean)=>({year:lunarYear,month:lunarMonth,day:lunarDay,leap});
   const named=(name:string)=>sorted(chart.palaces.flatMap(p=>p.stars.filter(s=>s.name===name).map(()=>p.branch)));
   const hua=sorted(chart.palaces.flatMap(p=>p.stars.filter(s=>s.siHua==='禄').map(()=>p.branch)));
   records.push({
    id:[year,String(month).padStart(2,'0'),'15',gender,hour].join('-'),
    solarDate:[year,String(month).padStart(2,'0'),'15'].join('-'),
    year,month,day:15,gender,hour,
    diagnostic:{
     rawLunar:point(raw.lunarYear,raw.lunarMonth,raw.lunarDay,raw.isLeap),
     reportedLunar:point(chart.lunarInfo.lunarYear,chart.lunarInfo.lunarMonth,chart.lunarInfo.lunarDay,chart.lunarInfo.isLeapMonth),
     cuc:chart.wuxingJu,
     liem:named('廉贞'),kong:named('地空'),jie:named('地劫'),hua
    },
    mingBranch:ming,sevenBranch:seven,luBranch,horseBranch,
    periods:sortedPeriods.map(dx=>({startAge:dx.startAge,branch:dx.palaceBranch})),
    sourceVoidByName:namedVoid,voidNamesAtMing:sourceMingVoid,
    parts:{liemAtMing:liem,luOrHuaLuAtMing:luMing,
     diKongAndDiJieAtMing:kongJieBoth,
     luInSourceVoid:isVoid(luBranch!),horseInSourceVoid:isVoid(horseBranch!)},
    sourcePredicates:{'dinh-ban-01':sourceBan1,'dinh-ban-02':sourceBan2,
     'dinh-tap-03':actualTap3},
    independentPredicates:{'dinh-ban-01':independentBan1,'dinh-ban-02':independentBan2,
     'dinh-tap-03':independentTap3}
   });
  }
if(records.length!==960||new Set(records.map(x=>x.id)).size!==960)
 throw Error('R61 did not cover all 960 genuine source charts');
const hitCounts={
 'dinh-ban-01':records.filter(x=>x.sourcePredicates['dinh-ban-01']).length,
 'dinh-ban-02':records.filter(x=>x.sourcePredicates['dinh-ban-02']).length,
 'dinh-tap-03-periods':records.reduce((n,x)=>n+x.sourcePredicates['dinh-tap-03'].length,0)
};
// R79 independent coverage extension: all 60 Can Chi years, one fixed
// late-year civil date, all hours and both genders. Keep R61's 960 rows intact.
const cycleRecords=[];
for(let year=1984;year<2044;year++)for(const gender of ['male','female'] as const)
 for(let hour=0;hour<12;hour++){
  const chart=generateChart({year,month:11,day:15,hour,gender});
  const ming=chart.mingGongBranch;
  const named=(name:string)=>sorted(chart.palaces.flatMap(p=>p.stars.filter(s=>s.name===name).map(()=>p.branch)));
  const hua=sorted(chart.palaces.flatMap(p=>p.stars.filter(s=>s.siHua==='禄').map(()=>p.branch)));
  const voidByName=Object.fromEntries(names.map(name=>[name,named(name)]));
  const placements={lu:named('禄存'),kong:named('地空'),jie:named('地劫'),hua};
  const hit=Boolean(ban2.fn(chart));
  const independent=(placements.lu.includes(ming)||hua.includes(ming))&&
   placements.kong.includes(ming)&&placements.jie.includes(ming)&&
   names.some(name=>voidByName[name].includes(ming));
  if(hit!==independent||detectDingPin(chart).some(x=>x.no===2)!==hit)
   throw Error('R79 source detector mismatch');
  cycleRecords.push({id:[year,'11','15',gender,hour].join('-'),solarDate:year+'-11-15',
   year,gender,hour,ming,placements,voidByName,hit,
   lunar:{year:chart.lunarInfo.lunarYear,month:chart.lunarInfo.lunarMonth,day:chart.lunarInfo.lunarDay,leap:chart.lunarInfo.isLeapMonth}});
 }
if(cycleRecords.length!==1440||new Set(cycleRecords.map(x=>x.id)).size!==1440)
 throw Error('R79 incomplete 60-year source coverage');
// R80: search the Hóa Lộc-only arm with actual source charts, then test
// necessity of each predicate operand on copies of genuine positive charts.
// The modified charts are logic interventions, never birth-chart evidence.
const r80={searched:0,sourcePositive:0,locOnly:0,huaOnly:0,bothLoc:0,positives:[] as Array<{
 id:string; solarDate:string; gender:'male'|'female'; hour:number;
 lunar:{year:number;month:number;day:number;leap:boolean}; ming:number;
 loc:boolean;hua:boolean;labels:string[];modes:Record<string,boolean>;
}>};
for(let year=1984;year<2044;year++)for(let month=1;month<=12;month++)
 for(const hour of [0,6]){
  const gender='male' as const;
  const chart=generateChart({year,month,day:15,hour,gender});
  r80.searched++;
  const palace=chart.palaces.find(p=>p.branch===chart.mingGongBranch)!;
  const loc=palace.stars.some(s=>s.name==='禄存');
  const hua=palace.stars.some(s=>s.siHua==='禄');
  const labels=names.filter(n=>palace.stars.some(s=>s.name===n));
  const kong=palace.stars.some(s=>s.name==='地空'),jie=palace.stars.some(s=>s.name==='地劫');
  const hit=Boolean(ban2.fn(chart));
  if(hit!==((loc||hua)&&kong&&jie&&labels.length>0))throw Error('R80 source oracle disagrees');
  if(!hit)continue;
  r80.sourcePositive++;if(loc&&hua)r80.bothLoc++;else if(loc)r80.locOnly++;else r80.huaOnly++;
  const evaluate=(remove:readonly string[],dropHua=false)=>{
   const copy=structuredClone(chart);
   const m=copy.palaces.find(p=>p.branch===copy.mingGongBranch)!;
   m.stars=m.stars.filter(s=>!remove.includes(s.name));
   if(dropHua)for(const star of m.stars)if(star.siHua==='禄')delete star.siHua;
   return Boolean(ban2.fn!(copy));
  };
  const modes={original:hit,withoutLoc:evaluate(['禄存']),withoutHua:evaluate([],true),
   withoutBothLoc:evaluate(['禄存'],true),withoutKong:evaluate(['地空']),
   withoutJie:evaluate(['地劫']),withoutVoid:evaluate(names),
   xunOnly:evaluate(['截路','截空','空亡','副截']),
   jiekongOnly:evaluate(['旬空','副旬'])};
  if(modes.withoutBothLoc||modes.withoutKong||modes.withoutJie||modes.withoutVoid||
    modes.withoutLoc!==hua||modes.withoutHua!==loc||
    modes.xunOnly!==labels.some(n=>n==='旬空'||n==='副旬')||
    modes.jiekongOnly!==labels.some(n=>n!=='旬空'&&n!=='副旬'))
   throw Error('R80 source ablation mismatch');
  if(!ban2.fn(chart))throw Error('R80 original chart mutated');
  const solarDate=[year,String(month).padStart(2,'0'),'15'].join('-');
  r80.positives.push({id:solarDate+'-'+gender+'-'+hour,solarDate,gender,hour,
   lunar:{year:chart.lunarInfo.lunarYear,month:chart.lunarInfo.lunarMonth,day:chart.lunarInfo.lunarDay,leap:chart.lunarInfo.isLeapMonth},
   ming:chart.mingGongBranch,loc,hua,labels,modes});
 }
if(r80.searched!==1440)throw Error('R80 incomplete targeted source search');
// R81: regular lunar month 10, every valid day, in year/hour pairs
// whose actual R79 year/hour coordinates permit a Hua-only positive.
// This is a bounded search, not an exhaustive claim over all school variants.
const r81Candidates=cycleRecords.filter(row=>{
 if(row.gender!=='male'||![0,6].includes(row.hour))return false;
 const target=row.hour===0?11:5;
 return row.placements.kong.includes(target)&&row.placements.jie.includes(target)&&
  !row.placements.lu.includes(target)&&names.some(n=>row.voidByName[n].includes(target));
});
const r81Rows=[];
const r81Groups=[];
for(const candidate of r81Candidates){
 const {year,hour}=candidate;
 const days=LunarMonth.fromYm(year,10).getDayCount();
 if(days!==29&&days!==30)throw Error('R81 invalid regular lunar month');
 r81Groups.push({year,hour,days});
 for(let day=1;day<=days;day++){
  const solarDate=Lunar.fromYmd(year,10,day).getSolar().toYmd();
  const [sy,sm,sd]=solarDate.split('-').map(Number);
  const chart=generateChart({year:sy,month:sm,day:sd,hour,gender:'male'});
  const palace=chart.palaces.find(p=>p.branch===chart.mingGongBranch)!;
  const loc=palace.stars.some(s=>s.name==='禄存'),hua=palace.stars.some(s=>s.siHua==='禄');
  const kong=palace.stars.some(s=>s.name==='地空'),jie=palace.stars.some(s=>s.name==='地劫');
  const labels=names.filter(n=>palace.stars.some(s=>s.name===n));
  const hit=Boolean(ban2.fn(chart));
  if(hit!==((loc||hua)&&kong&&jie&&labels.length>0)||detectDingPin(chart).some(x=>x.no===2)!==hit)
   throw Error('R81 detector mismatch');
  const d=chart.lunarInfo;
  const lunar={year:d.lunarYear,month:d.lunarMonth,day:d.lunarDay,leap:d.isLeapMonth};
  const target=hour===0?11:5;
  const aligned=lunar.year===year&&lunar.month===10&&lunar.day===day&&!lunar.leap&&chart.mingGongBranch===target;
  let withoutHua:boolean|null=null,withoutLoc:boolean|null=null;
  if(hit&&hua&&!loc){
   const copy=structuredClone(chart);
   const m=copy.palaces.find(p=>p.branch===copy.mingGongBranch)!;
   m.stars=m.stars.filter(s=>s.name!=='禄存');
   withoutLoc=Boolean(ban2.fn(copy));
   for(const star of m.stars)if(star.siHua==='禄')delete star.siHua;
   withoutHua=Boolean(ban2.fn(copy));
   if(!withoutLoc||withoutHua||!ban2.fn(chart))throw Error('R81 Hua-only ablation mismatch');
  }
  r81Rows.push({id:[year,10,day,hour].join('-'),year,hour,day,solarDate,lunar,aligned,
   ming:chart.mingGongBranch,loc,hua,kong,jie,labels,hit,withoutHua,withoutLoc});
 }
}
if(r81Rows.length!==r81Groups.reduce((n,g)=>n+g.days,0)||new Set(r81Rows.map(r=>r.id)).size!==r81Rows.length)
 throw Error('R81 missing day coverage');
writeFileSync('../.r61-pinned-source-void-predicate-observations.json',
 JSON.stringify({
  schema:'thiendo-r61-pinned-source-void-predicates-v1',
  provenance:{repository:'Renhuai123/ziwei-doushu',commit:source,
   iztroVersion:installed.version,sourceExecuted:true,syntheticOnly:true,
   usedDetectors:['DING_PIN_GE','DING_ZA_GE','detectDingPin','detectDingZa']},
  sourceSixVoidNames:names,years,months,hours:12,genders:['male','female'],
  caseCount:records.length,hitCounts,records,
  r79Cycle:{schema:'thiendo-r79-sexagenary-void-controls-v1',records:cycleRecords},
  r80Targeted:{schema:'thiendo-r80-ban02-targeted-ablation-v1',...r80},
  r81HuaOnly:{schema:'thiendo-r81-hua-only-lunar-day-search-v1',groups:r81Groups,records:r81Rows}
 },null,2)+'\n');
console.log('R61: 960 source charts, six separately named void stars, source predicate hits '+JSON.stringify(hitCounts));
